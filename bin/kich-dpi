UNIT = "kich-dpi.service"
TABLE = "kich_dpi"
QUEUE = 230
FWMARK = "0x10000000"
# Policy rule that sends DPI-stamped packets out the physical link. mihomo owns
# the 9000 block, so the DPI rule sits just above it.
DPI_RULE_PRIORITY = 8999
ENGINE_SLUG = "kich-dpi"
ENGINE_ROOT = Path("/opt") / ENGINE_SLUG
APP_DIR = ENGINE_ROOT / "app"
