import subprocess
import sys
import tarfile
import tempfile
import time
import urllib.error
import urllib.request
from pathlib import Path

VERSION = "0.2.1"

UNIT = "kich-dpi.service"
TABLE = "kich_dpi"
QUEUE = 230
FWMARK = "0x10000000"
ENGINE_SLUG = "kich-dpi"
ENGINE_ROOT = Path("/opt") / ENGINE_SLUG
APP_DIR = ENGINE_ROOT / "app"
ENGINE_DIR = ENGINE_ROOT / "engine"
UNIT_PATH = Path("/etc/systemd/system") / UNIT
POLKIT_PATH = Path("/etc/polkit-1/rules.d/49-kich-dpi.rules")
SYSCTL_PATH = Path("/etc/sysctl.d/90-kich-dpi.conf")

RELEASE_API = "https://api.github.com/repos/bol-van/zapret2/releases/latest"
TARGETS = (
    ("youtube", "YouTube", "https://www.youtube.com/"),
    ("discord", "Discord", "https://discord.com/"),
    ("google", "Google", "https://www.google.com/generate_204"),
)

HOME = Path(os.environ.get("HOME") or pwd.getpwuid(os.getuid()).pw_dir)
CONFIG_DIR = HOME / ".config" / ENGINE_SLUG
STATE_DIR = HOME / ".local" / "state" / ENGINE_SLUG
RUN_DIR = Path("/run") / ENGINE_SLUG
ACTIVE_FILE = CONFIG_DIR / "active.json"
STRATEGIES_FILE = CONFIG_DIR / "strategies.json"
CHECK_FILE = STATE_DIR / "check.json"
PROGRESS_FILE = STATE_DIR / "progress.json"

# WARP (MASQUE) is an optional second engine. It is deliberately separate from
# the DPI path: mihomo owns the tunnel and its config is generated locally.
WARP_UNIT = "kich-dpi-warp.service"
WARP_UNIT_PATH = Path("/etc/systemd/system") / WARP_UNIT
MIHOMO = ENGINE_ROOT / "mihomo"
WARP_CONFIG = CONFIG_DIR / "warp.yaml"
WARP_DATA = HOME / ".local" / "share" / ENGINE_SLUG
WARP_ACCOUNT = WARP_DATA / "account.json"
WARP_CHECK_FILE = STATE_DIR / "warp-check.json"
CF_ORIGIN = "https://api.cloudflareclient.com"
CF_VERSION = "v0a4471"
CF_HEADERS = {
    "User-Agent": "WARP for Android",
    "CF-Client-Version": "a-6.35-4471",
    "Content-Type": "application/json; charset=UTF-8",
    "Accept": "application/json",
    "Accept-Encoding": "identity",
}
# MASQUE gateways excluded from the DPI queue. Only the `…​.2` addresses of
# each anycast pair speak H2 with the secp256r1 key Cloudflare hands out at
# registration; the `…​.1` twins answer with a different key and fail the
# handshake (x509).
WARP_ENDPOINTS = ("162.159.198.2", "162.159.199.2", "162.159.197.2", "162.159.196.2")
# One pinned gateway instead of a latency-rotated pool. Switching between
# gateways mid-session dropped roughly a third of the TLS handshakes while a
# pinned one answered 40 of 40 in a row. 198.2 is the H2 endpoint WARP's own
# clients use.
WARP_ENDPOINT = "162.159.198.2"
WARP_SNI = "speed.cloudflare.com"
# mihomo marks every socket it opens with this value (`routing-mark`). DPI then
# leaves those packets alone: RU traffic that mihomo sends DIRECT runs through
# its own TCP stack, and the desync tricks meant for a kernel socket confuse
# that stack (gosuslugi.ru timed out until this skip was added).
WARP_MARK = "0x20000000"
WARP_DIRECT = (
    # Russian services that must not leave the country through the tunnel.
    "yandex.ru", "ya.ru", "yandex.net", "yandexcloud.net", "kinopoisk.ru",
    "vk.com", "vk.ru", "userapi.com", "ok.ru", "mail.ru", "max.ru",
    "gosuslugi.ru", "mos.ru", "nalog.gov.ru", "nalog.ru", "mosreg.ru",
    "sberbank.ru", "sber.ru", "sbol.ru", "tinkoff.ru", "tbank.ru",
    "vtb.ru", "alfabank.ru", "gazprombank.ru", "psbank.ru", "mkb.ru",
    "raiffeisen.ru", "rshb.ru", "open.ru", "rosselhozbank.ru",
    "wildberries.ru", "ozon.ru", "avito.ru", "dns-shop.ru", "2gis.ru",
    "rutube.ru", "dzen.ru", "mts.ru", "beeline.ru", "megafon.ru",
    "tele2.ru", "rt.ru", "pochta.ru", "rzd.ru", "aeroflot.ru", "s7.ru",
)



class Fail(Exception):
    pass


def out(data):
    sys.stdout.write(json.dumps(data, ensure_ascii=False, separators=(",", ":")) + "\n")


def log(text):
    sys.stderr.write(str(text).rstrip() + "\n")


def read_json(path, fallback):
    try:
        with open(path, "r", encoding="utf-8") as fh:
            value = json.load(fh)
        return value if isinstance(value, (dict, list)) else fallback
    except (OSError, ValueError):
        return fallback


def write_json(path, data):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name("." + path.name + ".tmp")
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(data, fh, ensure_ascii=False, indent=1)
        fh.write("\n")
    os.replace(tmp, path)


def require_root():
    if os.geteuid() != 0:
        raise Fail("нужен root: запустите через pkexec")


def target_user():
    uid = os.environ.get("PKEXEC_UID") or os.environ.get("SUDO_UID")
    if uid:
        try:
            return pwd.getpwuid(int(uid))
        except (ValueError, KeyError):
            pass
    if os.geteuid() != 0:
        return pwd.getpwuid(os.geteuid())
    raise Fail("не удалось определить пользователя: запустите установку из своей сессии")


def machine_arch():
    machine = platform.machine().lower()
    table = {
        "x86_64": "x86_64",
        "amd64": "x86_64",
        "aarch64": "arm64",
        "arm64": "arm64",
        "armv7l": "arm",
        "armv6l": "arm",
        "i686": "x86",
        "i386": "x86",
        "riscv64": "riscv64",
        "mips": "mips",
        "mipsel": "mipsel",
        "mips64": "mips64",
        "ppc": "ppc",
    }
    return table.get(machine, machine)


def engine_bin():
    return ENGINE_DIR / "current" / "nfqws2"


def engine_lua(name):
    return ENGINE_DIR / "current" / "lua" / name


def installed_version():
    info = read_json(ENGINE_ROOT / "install.json", {})
    version = info.get("version") if isinstance(info, dict) else ""
    if version and engine_bin().exists():
        return str(version)
    if engine_bin().exists():
        return "установлен"
    return ""


def installed():
    return bool(installed_version()) and engine_lua("zapret-lib.lua").exists() \
        and engine_lua("zapret-antidpi.lua").exists()


def systemctl(*args, timeout=25):
    try:
        return subprocess.run(
            ["systemctl", *args, UNIT],
            capture_output=True, text=True, timeout=timeout,
        )
    except (OSError, subprocess.SubprocessError) as exc:
        return subprocess.CompletedProcess(["systemctl", *args, UNIT], 1, "", str(exc))


def unit_state():
    if not UNIT_PATH.exists() and not installed():
        return "inactive", "not-found"
    active = systemctl("is-active").stdout.strip() or "inactive"
    enabled = systemctl("is-enabled").stdout.strip() or "disabled"
    return active, enabled


def is_running():
    return unit_state()[0] == "active"


def strategy_name(spec):
    return str(spec.get("name") or "своя стратегия")


def strategy_id(spec):
    payload = json.dumps(spec, ensure_ascii=False, sort_keys=True).encode("utf-8")
    return hashlib.sha1(payload).hexdigest()[:10]


# --------------------------------------------------------------- strategies

FOOLING = {
    "tcp_md5": "tcp_md5",
    "ip_ttl": "ip_ttl=1:ip6_ttl=1",
    "tcp_seq": "tcp_seq=-10000",
    "tcp_flags": "tcp_flags_unset=ack",
}


def candidates():
    """A deliberately small, ordered tree of strategies.

    The first four are the combinations that work on most Russian ISPs; the
    rest vary the split position, fooling and fake repeats. Generation means
    building these configurations and measuring them, not picking a preset.
    """

    result = []

    def add(name, action, pos, fool, fake="fake_default_tls", repeats=6,
            quic="quic_google", quic_repeats=6):
        result.append({
            "name": name,
            "action": action,
            "pos": pos,
            "fool": fool,
            "fake": fake,
            "repeats": repeats,
            "quic": quic,
            "quic_repeats": quic_repeats,
        })

    add("fake + multidisorder", "multidisorder", "1,midsld", "tcp_md5")
    add("fake + multisplit", "multisplit", "midsld", "tcp_md5")
    add("fakeddisorder", "fakeddisorder", "midsld", "tcp_md5", fake=None)
    add("fakedsplit", "fakedsplit", "midsld", "tcp_md5", fake=None)

    add("fake + disorder · TTL", "multidisorder", "1,midsld", "ip_ttl")
    add("fake + split · seq", "multisplit", "midsld", "tcp_seq")
    add("fake ×8 + disorder", "multidisorder", "1,midsld", "tcp_md5", repeats=8,
        quic="fake_default_quic")
    add("fake + split · noack", "multisplit", "midsld", "tcp_flags")

    add("fake + split at 1", "multisplit", "1,midsld", "tcp_md5")
    add("fake + disorder at 2", "multidisorder", "2", "tcp_seq")
    add("fakedsplit at 1", "fakedsplit", "1", "tcp_md5", fake=None)
    add("fake + split · sld", "multisplit", "sld+1", "tcp_md5",
        quic="quic_google", quic_repeats=4)

    return result


def default_spec():
    return candidates()[0]


def render_config(spec, dry_run=False):
    """Render one nfqws2 config. Every line is exactly one option."""
    lines = [
        "--qnum=%d" % QUEUE,
        "--fwmark=%s" % FWMARK,
        "--comment=kich-dpi",
        "--ctrack-disable=0",
        "--ipcache-lifetime=8400",
        "--lua-init=@%s" % engine_lua("zapret-lib.lua"),
        "--lua-init=@%s" % engine_lua("zapret-antidpi.lua"),
        "--blob=tls_google:@%s" % (ENGINE_DIR / "current" / "files" / "fake" / "tls_clienthello_www_google_com.bin"),
        "--blob=quic_google:@%s" % (ENGINE_DIR / "current" / "files" / "fake" / "quic_initial_www_google_com.bin"),
    ]
    if dry_run:
        lines.insert(0, "--dry-run")

    lines += [
        "--filter-tcp=80",
        "--filter-l7=http",
        "--payload=http_req",
        "--out-range=-d12",
        "--lua-desync=fake:blob=fake_default_http:tcp_md5",
        "--lua-desync=multisplit:pos=method+2",
        "--new",
        "--filter-tcp=443",
        "--filter-l7=tls",
        "--payload=tls_client_hello",
        "--out-range=-d12",
    ]

    action = str(spec.get("action") or "multisplit")
    pos = str(spec.get("pos") or "midsld")
    fool = FOOLING.get(str(spec.get("fool") or ""), "")
    fake = spec.get("fake")
    repeats = max(1, int(spec.get("repeats") or 1))

    if fake:
        args = "blob=%s:repeats=%d" % (fake, repeats)
        if fool:
            args += ":" + fool
        args += ":tls_mod=rnd,rndsni"
        lines.append("--lua-desync=fake:" + args)

    if action in ("fakedsplit", "fakeddisorder"):
        args = "pattern=tls_google:pos=%s" % pos
        if fool:
            args += ":" + fool
        lines.append("--lua-desync=%s:%s" % (action, args))
    else:
        args = "pos=%s" % pos
        if fool and action in ("multisplit", "multidisorder"):
            args += ":" + fool
        lines.append("--lua-desync=%s:%s" % (action, args))

    quic = str(spec.get("quic") or "quic_google")
    quic_repeats = max(1, int(spec.get("quic_repeats") or 6))
    lines += [
        "--new",
        "--filter-udp=443",
        "--filter-l7=quic",
        "--payload=quic_initial",
        "--lua-desync=fake:blob=%s:repeats=%d" % (quic, quic_repeats),
    ]
    return "\n".join(lines) + "\n"


# ------------------------------------------------------------------ probing

def curl_available():
    return shutil.which("curl") is not None


def probe(targets=TARGETS, timeout=7):
    if not curl_available():
        raise Fail("не найден curl")
    results = []
    for key, label, url in targets:
        started = time.monotonic()
        try:
            cp = subprocess.run(
                [
                    "curl", "-sS", "-o", "/dev/null",
                    "--connect-timeout", "4", "--max-time", str(timeout),
                    "-A", "Mozilla/5.0 (X11; Linux x86_64)",
                    "-w", "%{http_code} %{time_total}",
                    url,
                ],
                capture_output=True, text=True, timeout=timeout + 3,
            )
            parts = (cp.stdout or "").strip().split()
            code = int(parts[0]) if parts and parts[0].isdigit() else 0
            elapsed = float(parts[1]) if len(parts) > 1 else (time.monotonic() - started)
            ok = cp.returncode == 0 and 200 <= code < 400
            error = "" if ok else (cp.stderr or "").strip().splitlines()[-1:] or ""
            if isinstance(error, list):
                error = error[0] if error else ""
        except (OSError, subprocess.SubprocessError, ValueError) as exc:
            code, elapsed, ok, error = 0, time.monotonic() - started, False, str(exc)
        results.append({
            "key": key,
            "label": label,
            "ok": ok,
            "code": code,
            "ms": int(round(elapsed * 1000)),
            "error": error[:160],
        })
        time.sleep(0.15)
    passed = sum(1 for row in results if row["ok"])
    latency = sum(row["ms"] for row in results if row["ok"]) if passed else 10 ** 9
    return {
        "time": int(time.time()),
        "passed": passed,
        "total": len(results),
        "ms": latency,
        "results": results,
    }


def score(result):
    if not result.get("passed"):
        return (0, -10 ** 9)
    return (int(result["passed"]), -int(result.get("ms") or 10 ** 9))


def result_line(result):
    return "%d/%d · %.1f с" % (
        int(result.get("passed") or 0),
        int(result.get("total") or 0),
        (int(result.get("ms") or 0) / 1000.0) if result.get("passed") else 0,
    )


# ------------------------------------------------------------------- install

def release_info():
    req = urllib.request.Request(RELEASE_API, headers={
        "User-Agent": "kich-dpi/%s" % VERSION,
        "Accept": "application/vnd.github+json",
    })
    with urllib.request.urlopen(req, timeout=30) as resp:
        data = json.load(resp)
    tag = str(data.get("tag_name") or "")
    assets = {str(a.get("name")): a for a in data.get("assets") or []}
    name = "zapret2-%s.tar.gz" % tag
    asset = assets.get(name)
    if not tag or not asset:
        raise Fail("в последнем релизе zapret2 нет %s" % name)
    return tag, str(asset.get("browser_download_url") or ""), str(asset.get("digest") or "")


def download(url, dest):
    req = urllib.request.Request(url, headers={"User-Agent": "kich-dpi/%s" % VERSION})
    with urllib.request.urlopen(req, timeout=120) as resp, open(dest, "wb") as fh:
        shutil.copyfileobj(resp, fh, 1024 * 256)


def sha256_file(path):
    digest = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(1024 * 256), b""):
            digest.update(chunk)
    return digest.hexdigest()


def extract_engine(archive, tag):
    arch = machine_arch()
    stage = ENGINE_DIR / (".%s.new" % tag)
    if stage.exists():
        shutil.rmtree(stage)
    stage.mkdir(parents=True)

    with tempfile.TemporaryDirectory(prefix="kich-dpi-") as tmp:
        tmpdir = Path(tmp)
        with tarfile.open(archive, "r:gz") as tf:
            for member in tf.getmembers():
                if not member.isfile():
                    continue
                name = Path(member.name)
                if name.is_absolute() or ".." in name.parts:
                    continue
                tf.extract(member, tmpdir)

        roots = [p for p in tmpdir.iterdir() if p.is_dir()]
        if not roots:
            raise Fail("архив zapret2 пуст")
        root = roots[0]

        binary = root / "binaries" / ("linux-" + arch) / "nfqws2"
        if not binary.exists():
            raise Fail("в релизе нет nfqws2 для linux-%s" % arch)
        shutil.copy2(binary, stage / "nfqws2")
        os.chmod(stage / "nfqws2", 0o755)

        lua_src = root / "lua"
        if not lua_src.is_dir():
            raise Fail("в релизе нет lua/")
        shutil.copytree(lua_src, stage / "lua")

        fake_src = root / "files" / "fake"
        if fake_src.is_dir():
            shutil.copytree(fake_src, stage / "files" / "fake")
        else:
            raise Fail("в релизе нет files/fake")

    target = ENGINE_DIR / tag
    if target.exists():
        shutil.rmtree(target)
    stage.rename(target)

    current = ENGINE_DIR / "current"
    if current.is_symlink() or current.exists():
        current.unlink()
    current.symlink_to(tag)
    return target


def github_latest_tag(repo):
    """Resolve the latest release tag without the API (which is rate limited)."""
    url = "https://github.com/%s/releases/latest" % repo
    req = urllib.request.Request(url, headers={"User-Agent": "kich-dpi/%s" % VERSION})
    try:
        with urllib.request.urlopen(req, timeout=25) as resp:
            final = resp.geturl()
    except urllib.error.HTTPError as exc:
        raise Fail("GitHub ответил HTTP %s" % exc.code)
    except urllib.error.URLError as exc:
        raise Fail("нет связи с GitHub: %s" % exc.reason)
    tag = final.rstrip("/").rsplit("/", 1)[-1]
    if not tag.startswith("v"):
        raise Fail("не удалось определить версию релиза")
    return tag


def mihomo_release():
    arch = {"x86_64": "amd64", "arm64": "arm64"}.get(machine_arch())
    if not arch:
        raise Fail("нет сборки mihomo для архитектуры %s" % machine_arch())
    tag = ""
    digest = ""
    try:
        req = urllib.request.Request(
            "https://api.github.com/repos/MetaCubeX/mihomo/releases/latest",
            headers={"User-Agent": "kich-dpi/%s" % VERSION, "Accept": "application/vnd.github+json"},
        )
        with urllib.request.urlopen(req, timeout=25) as resp:
            data = json.load(resp)
        tag = str(data.get("tag_name") or "")
        assets = {str(asset.get("name")): asset for asset in data.get("assets") or []}
        for name in ("mihomo-linux-%s-compatible-%s.gz" % (arch, tag),
                     "mihomo-linux-%s-%s.gz" % (arch, tag)):
            asset = assets.get(name)
            if asset:
                return tag, str(asset.get("browser_download_url") or ""), \
                    str(asset.get("digest") or "")
    except Exception:
        pass  # fall through to the redirect-based resolution below
    if not tag:
        tag = github_latest_tag("MetaCubeX/mihomo")
    for name in ("mihomo-linux-%s-compatible-%s.gz" % (arch, tag),
                 "mihomo-linux-%s-%s.gz" % (arch, tag)):
        url = "https://github.com/MetaCubeX/mihomo/releases/download/%s/%s" % (tag, name)
        if remote_exists(url):
            return tag, url, digest
    raise Fail("не удалось найти сборку mihomo %s для %s" % (tag, arch))


def remote_exists(url):
    req = urllib.request.Request(url, method="HEAD",
                                 headers={"User-Agent": "kich-dpi/%s" % VERSION})
    try:
        with urllib.request.urlopen(req, timeout=20) as resp:
            return resp.status == 200
    except Exception:
        return False


def install_mihomo():
    """Download mihomo next to the DPI engine. Root only; called from setup."""
    if warp_available():
        return mihomo_version()
    local = os.environ.get("KICH_DPI_MIHOMO_ARCHIVE")
    if local:
        tag, url, digest = "custom", "", ""
        source = Path(local)
        if not source.exists():
            raise Fail("архив mihomo не найден: %s" % local)
    else:
        tag, url, digest = mihomo_release()
    with tempfile.TemporaryDirectory(prefix="kich-dpi-mihomo-") as tmp:
        archive = Path(tmp) / "mihomo.gz"
        if local:
            shutil.copy2(source, archive)
        else:
            try:
                download(url, archive)
            except Exception as exc:
                raise Fail("не удалось скачать mihomo: %s" % exc)
        if digest.startswith("sha256:"):
            actual = "sha256:" + sha256_file(archive)
            if actual.lower() != digest.lower():
                raise Fail("sha256 mihomo не совпал")
        target = MIHOMO.with_name(".mihomo.new")
        try:
            with gzip.open(archive, "rb") as src, open(target, "wb") as dst:
                shutil.copyfileobj(src, dst, 1024 * 256)
        except (OSError, gzip.BadGzipFile) as exc:
            raise Fail("повреждён архив mihomo: %s" % exc)
        os.chmod(target, 0o755)
        check = subprocess.run([str(target), "-v"], capture_output=True, text=True, timeout=20)
        if check.returncode != 0:
            target.unlink(missing_ok=True)
            raise Fail("скачанный mihomo не запускается")
        os.replace(target, MIHOMO)
    write_json(ENGINE_ROOT / "mihomo.json", {"version": tag, "installed": int(time.time()),
                                             "sha256": digest})
    return tag


def mihomo_version():
    info = read_json(ENGINE_ROOT / "mihomo.json", {})
    return str(info.get("version") or "") if isinstance(info, dict) else ""


def write_text(path, text, mode=0o644):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name("." + path.name + ".tmp")
    with open(tmp, "w", encoding="utf-8") as fh:
        fh.write(text)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


