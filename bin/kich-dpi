ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
"""

POLKIT_TEMPLATE = """// Installed by kich-dpi. Allows the session user to start and stop the bypass
// and the optional WARP tunnel without a password.
polkit.addRule(function(action, subject) {{
  if (action.id !== "org.freedesktop.systemd1.manage-units") return;
  if (subject.user !== "{user}") return;
  var unit = action.lookup("unit");
  if (unit === "{unit}" || unit === "{warp_unit}") return polkit.Result.YES;
}});
"""

WARP_UNIT_TEMPLATE = """# Installed by kich-dpi (Omarchy plugin). Removed by `kich-dpi remove`.
[Unit]
